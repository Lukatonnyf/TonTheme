{
	"name": "TonTheme",

	"colors": {
		"editor.background": "#1B1913",
    "focusBorder": "#2A2822",
    "editorCursor.foreground": "#636563",
    "editor.selectionBackground":"#31495f",
    "editor.selectionHighlightBackground": "#31495f",
    "editor.inactiveSelectionBackground": "#264f7880",
    "editor.wordHighlightBackground": "#575757b8",
    "editor.wordHighlightStrongBackground":"#004972b8",
    "editor.findMatchBackground": "#31495f",
    "editor.findMatchHighlightBackground": "#3b4a5555",
    "editor.findRangeHighlightBackground": "#201E18",
    "editor.hoverHighlightBackground": "#2A2822",
    "editor.lineHighlightBackground": "#2A2822",
    "editor.lineHighlightBorder": "#1B1913",
    "editorLink.activeForeground": "#4e94ce",
    "editorWhitespace.foreground":"#2a2a2a",
    "editorIndentGuide.background":"#2a2a2a",
    "editorRuler.foreground":"#201E18",
    "editorOverviewRuler.findMatchForeground": "#877878",


    "editorWidget.background": "#1B1913",
    "editorWidget.border": "#2a2a2a",
    "input.background": "#201E18",
    "input.border": "#2a2a2a",
    "input.foreground": "#a9a9a9",

    // Hover Tooltip
    "editorHoverWidget.background": "#14120B",
    "editorHoverWidget.border": "#2a2a2a",
    "editorHoverWidget.foreground": "#a9a9a9",
     "editorSuggestWidget.foreground": "#bbbbbb",

     // Group and Guides to Editor
    "editorGroup.dropBackground": "#201E18",
    "editorGroup.border": "#1B1913",

    //  Group and Guides to Editor - Open tabs menu
    "editorGroupHeader.tabsBackground": "#14120B",
    "editorGroupHeader.tabsBorder": "#1a1a1a",
    "tab.activeBackground": "#14120B",
    "tab.inactiveBackground":"#201E18",
    "tab.hoverBackground":  "#1B1913",
    "tab.activeBorder": "#14120B",

    // SideBar
    "sideBar.background": "#14120B",
    "sideBarSectionHeader.foreground": "#a9a9a9",
    "sideBar.border": "#1B1913",

    // SideBar - Activetys Bar
    "activityBar.background": "#14120B",
    "activityBar.border": "#1B1913",
    "activityBar.activeBorder": "#7d7d7d",
    "activityBar.activeBackground":"#1B1913",

    // Header Bar
    "titleBar.activeBackground": "#14120B",

    // Terminal
    "panel.background": "#14120B",
    "terminal.background": "#14120B",

    // StatusBar
    "statusBar.background": "#14120B",
    "statusBarItem.focusBorder": "#2A2822",
    "statusBarItem.hoverBackground": "#1B1913",
    "statusBar.debuggingBackground": "#14120B",
    "statusBar.noFolderBackground": "#14120B",

    // Explorer
    "list.activeSelectionBackground": "#201E18",
  	"list.inactiveSelectionBackground": "#201E18",
    "list.hoverBackground": "#1B1913",

    // Quick Open (Ctrl + P)
    "quickInput.background": "#1B1913",
    "quickInput.foreground": "#a9a9a9",
    "quickInputList.focusBackground": "#2A2822",

    "dropdown.background": "#1B1913",
    "dropdown.border": "#2A2822",
    "dropdown.foreground": "#FFFFFF",

    "button.background": "#313030",
    "button.hoverBackground": "#424141",
    "button.foreground": "#d1cfcf",


    "menu.background": "#14120B",
    "menu.foreground": "#a9a9a9",
    "menu.selectionForeground": "#FFFFFF",

"editor.tokenColorCustomizations": {}


  },

"tokenColors": [{
			"settings": {
				"foreground": "#b392f0"
			}
		},
		{
			"scope": [
				"support.function",
				"keyword.operator.accessor",
				"meta.group.braces.round.function.arguments",
				"meta.template.expression",
				"markup.fenced_code meta.embedded.block"
			],
			"settings": {
				"foreground": "#b392f0"
			}
		},
		{
			"scope": "emphasis",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"strong",
				"markup.heading.markdown",
				"markup.bold.markdown"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#FF7A84"
			}
		},
		{
			"scope": [
				"markup.italic.markdown"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "meta.link.inline.markdown",
			"settings": {
				"fontStyle": "underline",
				"foreground": "#1976D2"
			}
		},
		{
			"scope": [
				"string",
				"markup.fenced_code",
				"markup.inline"
			],
			"settings": {
				"foreground": "#9db1c5"
			}
		},
		{
			"scope": [
				"comment",
				"string.quoted.docstring.multi"
			],
			"settings": {
				"foreground": "#6b737c"
			}
		},
		{
			"scope": [
				"constant.language",
				"variable.language.this",
				"variable.other.object",
				"variable.other.class",
				"variable.other.constant",
				"meta.property-name",
				"support",
				"string.other.link.title.markdown"
			],
			"settings": {
				"foreground": "#79b8ff"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.other.placeholder",
				"constant.character.format.placeholder",
				"meta.property-value",
				"keyword.other.unit",
				"keyword.other.template",
				"entity.name.tag.yaml",
				"entity.other.attribute-name",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#f8f8f8"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.modifier",
				"storage.type",
				"storage.control.clojure",
				"entity.name.function.clojure",
				"support.function.node",
				"punctuation.separator.key-value",
				"punctuation.definition.template-expression"
			],
			"settings": {
				"foreground": "#f97583"
			}
		},
		{
			"scope": "variable.parameter.function",
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.other.inherited-class",
				"meta.function-call",
				"meta.instance.constructor",
				"entity.other.attribute-name",
				"entity.name.function",
				"constant.keyword.clojure"
			],
			"settings": {
				"foreground": "#b392f0"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"string.quoted",
				"string.regexp",
				"string.interpolated",
				"string.template",
				"string.unquoted.plain.out.yaml",
				"keyword.other.template"
			],
			"settings": {
				"foreground": "#ffab70"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#316bcd"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#cd9731"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#cd3131"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#800080"
			}
		},
		{
			"scope": [
				"punctuation.definition.arguments",
				"punctuation.definition.dict",
				"punctuation.separator",
				"meta.function-call.arguments"
			],
			"settings": {
				"foreground": "#bbbbbb"
			}
		},
		{
			"name": "[Custom] Markdown links",
			"scope": "markup.underline.link",
			"settings": {
				"foreground": "#ffab70"
			}
		},
		{
			"name": "[Custom] Markdown list",
			"scope": [
				"beginning.punctuation.definition.list.markdown"
			],
			"settings": {
				"foreground": "#FF7A84"
			}
		},
		{
			"name": "[Custom] Markdown punctuation definition",
			"scope": "punctuation.definition.metadata.markdown",
			"settings": {
				"foreground": "#ffab70"
			}
		},
		{
			"name": "[Custom] Markdown punctuation definition brackets",
			"scope": [
				"punctuation.definition.string.begin.markdown",
				"punctuation.definition.string.end.markdown"
			],
			"settings": {
				"foreground": "#79b8ff"
			}
		}
	],
	"semanticHighlighting": true
}

